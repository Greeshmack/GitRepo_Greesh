			"name": "adf-pipelines-miniproject_ArmTemplate_0",
			"type": "Microsoft.Resources/deployments",
			"apiVersion": "2024-03-01",
			"properties": {
				"mode": "incremental",
				"templateLink": {
					"uri": "[concat(parameters('containerUri'), '/ArmTemplate_0.json', parameters('containerSasToken'))]",
					"contentVersion": "1.0.0.0"
				},
				"parameters": {
					"factoryName": {
						"value": "[parameters('factoryName')]"
					},
					"ASQL_Gold_LAyer_LS_password": {
						"value": "[parameters('ASQL_Gold_LAyer_LS_password')]"
					},
					"ASQL_Silver_Layer_LS_password": {
						"value": "[parameters('ASQL_Silver_Layer_LS_password')]"
					},
					"BLOB_Landing_Layer_LS_connectionString": {
						"value": "[parameters('BLOB_Landing_Layer_LS_connectionString')]"
					},
					"DataLake_Bronze_LS_accountKey": {
						"value": "[parameters('DataLake_Bronze_LS_accountKey')]"
					},
					"ASQL_Gold_LAyer_LS_properties_typeProperties_server": {
						"value": "[parameters('ASQL_Gold_LAyer_LS_properties_typeProperties_server')]"
					},
					"ASQL_Gold_LAyer_LS_properties_typeProperties_database": {
						"value": "[parameters('ASQL_Gold_LAyer_LS_properties_typeProperties_database')]"
					},
					"ASQL_Gold_LAyer_LS_properties_typeProperties_userName": {
						"value": "[parameters('ASQL_Gold_LAyer_LS_properties_typeProperties_userName')]"
					},
					"ASQL_Silver_Layer_LS_properties_typeProperties_server": {
						"value": "[parameters('ASQL_Silver_Layer_LS_properties_typeProperties_server')]"
					},
					"ASQL_Silver_Layer_LS_properties_typeProperties_database": {
						"value": "[parameters('ASQL_Silver_Layer_LS_properties_typeProperties_database')]"
					},
					"ASQL_Silver_Layer_LS_properties_typeProperties_userName": {
						"value": "[parameters('ASQL_Silver_Layer_LS_properties_typeProperties_userName')]"
					},
					"DataLake_Bronze_LS_properties_typeProperties_url": {
						"value": "[parameters('DataLake_Bronze_LS_properties_typeProperties_url')]"
					}
				}
			},
			"dependsOn": []
		},
		{
			"name": "adf-pipelines-miniproject_ArmTemplate_1",
			"type": "Microsoft.Resources/deployments",
			"apiVersion": "2024-03-01",
			"properties": {
				"mode": "incremental",
				"templateLink": {
					"uri": "[concat(parameters('containerUri'), '/ArmTemplate_1.json', parameters('containerSasToken'))]",
					"contentVersion": "1.0.0.0"
				},
				"parameters": {
					"factoryName": {
						"value": "[parameters('factoryName')]"
					},
					"EventStorage_properties_typeProperties_scope": {
						"value": "[parameters('EventStorage_properties_typeProperties_scope')]"
					}
				}
			},
			"dependsOn": [
				"[resourceId('Microsoft.Resources/deployments', 'adf-pipelines-miniproject_ArmTemplate_0')]"
			]
		}
	]
}